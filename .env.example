# =============================================================================
# Spaceship Logistics Analytics - Cloudflare Environment Variables Example
# =============================================================================
# In production on Cloudflare Workers, these values are configured in wrangler.jsonc
# under `vars` or provisioned via `wrangler secret put`.
# For local evaluation or remote development, copy to .dev.vars (gitignored).

# --- Cloudflare Workers AI Configuration ---
AI_ENABLED="false"
AI_ALLOW_PAID_ESCALATION="false"
AI_MODEL="@cf/google/gemma-4-26b-a4b-it"
AI_ESCALATION_MODEL="@cf/zai-org/glm-5.3-flash"
AI_FALLBACK_MODEL="@cf/zai-org/glm-4.7-flash"
# Optional: set this only to an existing AI Gateway id after reviewing its
# billing, caching and retention settings. It is intentionally unset here.
# AI_GATEWAY_ID="existing-gateway-id"
AI_MAX_INPUT_TOKENS="4096"
AI_MAX_OUTPUT_TOKENS="512"
AI_DAILY_ATTEMPT_LIMIT="100"
AI_MONTHLY_ATTEMPT_LIMIT="1000"
AI_DAILY_TOKEN_RESERVATION_LIMIT="180000"
AI_MIN_INTERVAL_SECONDS="60"
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="2"

# --- Optional Cloudflare Credentials (for live evaluation / remote deployment) ---
# CLOUDFLARE_API_TOKEN="your-api-token-here"
# CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
